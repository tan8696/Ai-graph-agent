# FalkorDB Connection
# Local Docker instance:
FALKORDB_URL=redis://localhost:6379

# FalkorDB Cloud (free tier instance):
# FALKORDB_URL=redis://username:password@your-cloud-instance.falkordb.cloud:port

# Google Gemini API Key (get free from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Default model override
GEMINI_MODEL=gemini-flash-lite-latest

# Optional: caps on Gemini-backed requests (per visitor IP per hour, whole site per day)
RATE_LIMIT_PER_IP_HOUR=10
RATE_LIMIT_GLOBAL_DAY=300
